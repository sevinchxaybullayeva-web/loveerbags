BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Sun'iy intellekt (AI) API kaliti:
# Google Gemini kaliti bepul: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Yoki OpenAI API kaliti (ixtiyoriy, agar Gemini o'rniga OpenAI ishlatmoqchi bo'lsangiz):
OPENAI_API_KEY=

# Ma'lumotlar bazasi nomi (o'zgartirish shart emas)
DB_PATH=hisobchi.db
